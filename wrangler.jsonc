{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "birpe",
  "compatibility_date": "2026-10-01",
  // Static site only: Cloudflare serves the Vite build output directly.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "birpe.com", "custom_domain": true },
    { "pattern": "www.birpe.com", "custom_domain": true }
  ]
}
