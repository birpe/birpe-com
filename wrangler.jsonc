{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "birpe",
  "compatibility_date": "2026-10-01",
  // Cloudflare serves the Vite build directly; only the waitlist reaches the Worker.
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "birpe-waitlist",
      "database_id": "5ba09e17-048f-4ebc-8265-af70685e74b6",
      "migrations_dir": "migrations"
    }
  ],
  // Five sign-up attempts a minute per visitor; counted at the edge, so no IPs are stored.
  "ratelimits": [
    { "name": "WAITLIST_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  "routes": [
    { "pattern": "birpe.com", "custom_domain": true },
    { "pattern": "www.birpe.com", "custom_domain": true }
  ]
}
